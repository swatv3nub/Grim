# GRIM Security Scanner Configuration
# Copy this file to .env and fill in your actual values

# API Keys
VIEWDNS_API_KEY=your_viewdns_api_key_here
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# Database Configuration (optional)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=grim_scanner
DB_USER=grim_user
DB_PASSWORD=grim_password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/grim.log

# Scanner Configuration
SCAN_TIMEOUT=30
MAX_CONCURRENT_SCANS=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Security Settings
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=60
BLOCKED_IPS=127.0.0.1,192.168.1.1

# Output Configuration
SAVE_RESULTS=true
RESULTS_DIR=results/
EXPORT_FORMATS=json,csv,html

# Proxy Configuration (optional)
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_USER=
PROXY_PASSWORD=
