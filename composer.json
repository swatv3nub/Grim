{
    "name": "grim/security-scanner",
    "description": "Advanced Information Gathering and Vulnerability Scanning Tool",
    "type": "project",
    "license": "GPL-3.0",
    "authors": [
        {
            "name": "GRIM Security Team",
            "email": "contact@grim-security.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/console": "^6.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.0",
        "symfony/yaml": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Grim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grim\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyse src",
        "cs": "phpcs src",
        "cs-fix": "phpcbf src"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
